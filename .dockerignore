# Version control and local tooling
.git
.github
.gitignore
.gitattributes
.vscode
.next
.turbo
.agents

# Dependencies and generated output
node_modules
**/node_modules
coverage
playwright-report
test-results
*.tsbuildinfo
next-env.d.ts
/app/generated/prisma/

# Local configuration, credentials, and logs
.env*
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local exports and scratch data (the app imports these JSON files)
/data/*
!/data/countries.json
!/data/states.json
/.tmp
/scratch/

# Docker files are not needed in the application image
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
compose*.yml
compose*.yaml